# Einmal nach .env.local kopieren. Diese Datei enthält keine Passwörter.
# 1 aktiviert GitHub Releases am Ende jedes lokalen Release-Builds.
LOCALSEEK_PUBLISH_RELEASE="${LOCALSEEK_PUBLISH_RELEASE:-0}"
# Optional: SHA-1 eines Apple-Development-Zertifikats für lokale XCTest-Bundles.
# LOCALSEEK_TEST_SIGN_IDENTITY="SHA1_AUS_SECURITY_FIND_IDENTITY"
if [[ "$LOCALSEEK_PUBLISH_RELEASE" == 1 ]]; then
  LOCALSEEK_SIGN_IDENTITY="${LOCALSEEK_SIGN_IDENTITY:-Developer ID Application: Dein Name (TEAMID)}"
  LOCALSEEK_NOTARY_PROFILE="${LOCALSEEK_NOTARY_PROFILE:-LocalSeek}"
  LOCALSEEK_RELEASE_REPOSITORY="${LOCALSEEK_RELEASE_REPOSITORY:-nasch72kadse/LocalSeek}"
fi
