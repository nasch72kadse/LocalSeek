# Copy once to .env.local. Do not put passwords in this file.
# Set to 1 to publish a GitHub Release after each local release build.
LOCALSEEK_PUBLISH_RELEASE="${LOCALSEEK_PUBLISH_RELEASE:-0}"
# Optional: SHA-1 of an Apple Development identity for local XCTest bundles.
# LOCALSEEK_TEST_SIGN_IDENTITY="SHA1_FROM_SECURITY_FIND_IDENTITY"
if [[ "$LOCALSEEK_PUBLISH_RELEASE" == 1 ]]; then
  LOCALSEEK_SIGN_IDENTITY="${LOCALSEEK_SIGN_IDENTITY:-Developer ID Application: Your Name (TEAMID)}"
  LOCALSEEK_NOTARY_PROFILE="${LOCALSEEK_NOTARY_PROFILE:-LocalSeek}"
  LOCALSEEK_RELEASE_REPOSITORY="${LOCALSEEK_RELEASE_REPOSITORY:-nasch72kadse/LocalSeek}"
fi
